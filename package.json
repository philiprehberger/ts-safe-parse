{
  "name": "@philiprehberger/safe-parse",
  "version": "0.1.3",
  "description": "Safe parsing for primitives — numbers, booleans, dates, JSON from unknown strings",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "parse",
    "coerce",
    "number",
    "boolean",
    "date",
    "json",
    "safe",
    "query-params"
  ],
  "author": "Philip Rehberger",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philiprehberger/ts-safe-parse.git"
  },
  "homepage": "https://github.com/philiprehberger/ts-safe-parse#readme",
  "bugs": {
    "url": "https://github.com/philiprehberger/ts-safe-parse/issues"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false
}
